# Copy this file to .env and fill in your local Postgres credentials.
# The values below match the docker-compose.yml defaults.
POSTGRES_USER=promptforge
POSTGRES_PASSWORD=promptforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=promptforge

# Alternatively, set a full connection URL directly.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Example (matches the docker-compose.yml defaults):
# DATABASE_URL=******localhost:5432/promptforge

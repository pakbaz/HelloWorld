# Root-level .gitignore

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build artifacts
frontend/dist/
frontend/dist-ssr/
backend/dist/

# Environment variables
*.local
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
